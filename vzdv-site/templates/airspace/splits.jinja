{% extends "_layout.jinja" %}

{% block title %}Enroute Sector Splits | {{ super() }}{% endblock %}

{% block extra_head %}
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />
  <script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""
  ></script>
  <script>
    var CARTO_KEY = "{{ carto_key }}";
  </script>
  <style>
    #split-map {
      height: 70vh;
      min-height: 400px;
      width: 100%;
      border-radius: 0.5rem;
      background: #1a1d20;
    }
    .sector-label {
      background: transparent;
      border: none;
      box-shadow: none;
      color: #fff;
      font-size: 0.75rem;
      font-weight: 600;
      text-align: center;
      text-shadow: 0 0 3px #000;
      pointer-events: none;
      line-height: 1;
    }
    .leaflet-container {
      background: #1a1d20;
    }
    .legend-swatch {
      width: 1rem;
      height: 1rem;
      display: inline-block;
      border-radius: 0.25rem;
      margin-right: 0.5rem;
      vertical-align: middle;
      border: 1px solid rgba(255, 255, 255, 0.4);
    }
    .custom-row {
      background: rgba(255, 255, 255, 0.05);
    }
    .custom-checkbox-list {
      max-height: 240px;
      overflow-y: auto;
      padding: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 0.25rem;
      background: rgba(0, 0, 0, 0.2);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .custom-checkbox-list label {
      margin-bottom: 0;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      cursor: pointer;
      font-size: 0.875rem;
    }
    .custom-checkbox-list input[type="checkbox"] {
      flex-shrink: 0;
    }
  </style>
{% endblock %}

{% block body %}
  <h2 class="mb-3">Enroute Sector Splits</h2>

  {% if event_split %}
    <div class="alert alert-info d-flex align-items-center justify-content-between" role="alert">
      <div class="d-flex align-items-center">
        <i class="bi bi-info-circle me-2"></i>
        <div><strong>{{ event_split }}</strong> is the current event split.</div>
      </div>
      <a href="/airspace/splits?split={{ event_split | urlencode }}" class="btn btn-sm btn-primary">View</a>
    </div>
  {% endif %}

  <div class="row g-3 mb-3 align-items-end flex-md-nowrap">
    <div class="col-md-auto" style="min-width: 220px;">
      <label for="split-select" class="form-label">Split configuration</label>
      <select id="split-select" class="form-select">
        {% for name in split_names %}
          <option value="{{ name }}" {% if name == current_split %}selected{% endif %}>{{ name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="col-md-auto d-flex align-items-center" id="band-toggle-col">
      <div class="btn-group" role="group" aria-label="Band">
        <button type="button" id="btn-high" class="btn btn-outline-light active">High (Above FL260)</button>
        <button type="button" id="btn-low" class="btn btn-outline-light">Low (AAB FL260)</button>
      </div>
    </div>
    <div class="col-12 col-md ms-md-auto text-md-end d-flex flex-wrap justify-content-md-end align-items-center gap-2">
      {% if can_create_split %}
        <button id="create-split" class="btn btn-outline-info btn-sm">
          <i class="bi bi-pencil-square"></i> Create Custom Split
        </button>
        <button id="save-split" class="btn btn-outline-success btn-sm">
          <i class="bi bi-floppy"></i> Save Split
        </button>
        <button id="delete-split" class="btn btn-outline-danger btn-sm">
          <i class="bi bi-trash"></i> Delete
        </button>
        <form id="delete-split-form" action="/airspace/splits/delete" method="POST" class="d-none">
          <input type="hidden" name="name" id="delete-split-name">
        </form>
      {% endif %}
      <button id="copy-link" class="btn btn-outline-light btn-sm">
        <i class="bi bi-link-45deg"></i> Copy Link
      </button>
    </div>
  </div>

  {% if can_create_split %}
    <div class="modal fade" id="saveSplitModal" tabindex="-1" aria-labelledby="saveSplitModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <form action="/airspace/splits/save" method="POST">
            <div class="modal-header">
              <h5 class="modal-title" id="saveSplitModalLabel">Save current split</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="config" id="save-split-config">
              <div class="mb-3">
                <label for="save-split-overwrite" class="form-label">Overwrite an existing split</label>
                <select class="form-select" name="overwrite_name" id="save-split-overwrite">
                  <option value="">-- Save as a new split --</option>
                  {% for name in split_names %}
                    <option value="{{ name }}">{{ name }}</option>
                  {% endfor %}
                </select>
                <div class="form-text">
                  Choose a split above to overwrite it, or leave this as "Save as a new split" and give it a name below.
                </div>
              </div>
              <div class="mb-3">
                <label for="save-split-name" class="form-label">New split name</label>
                <input type="text" class="form-control" name="name" id="save-split-name" maxlength="20" pattern="[^&?@]*">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary">Save</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  {% endif %}

  <div id="split-map" class="shadow-sm"></div>

  <div class="mt-3" id="legend"></div>

  {% if can_create_split %}
    <div class="modal fade" id="customSplitModal" tabindex="-1" aria-labelledby="customSplitModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="customSplitModalLabel">Create custom split</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-muted">Pick a controller for each altitude band, then choose areas or individual sectors they will cover.</p>
            <div class="row">
              <div class="col-md-6">
                <h6>High sectors</h6>
                <div id="custom-high-rows"></div>
                <button type="button" class="btn btn-sm btn-outline-light mt-2" id="add-high-row">Add controller</button>
              </div>
              <div class="col-md-6">
                <h6>Low sectors</h6>
                <div id="custom-low-rows"></div>
                <button type="button" class="btn btn-sm btn-outline-light mt-2" id="add-low-row">Add controller</button>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary" id="preview-custom-split">Preview & share</button>
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  <script type="application/json" id="splits-config">{{ splits_json | safe }}</script>
  <script type="text/plain" id="geojson-url">{{ geojson_url }}</script>
  <script type="text/plain" id="current-split">{{ current_split | safe }}</script>

  <script src="/static/splits.js" defer></script>
{% endblock %}
