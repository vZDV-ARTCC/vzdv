{% extends "_layout.jinja" %}
{% import "ids/_macros.jinja" as ids %}

{% block title %}IDS | {{ super() }}{% endblock %}

{% block extra_head %}
<style>#ids-page [hidden] { display: none !important; }</style>
{% endblock %}

{% macro airport_row(row) %}
<tr data-key="{{ row.icao or '' }}">
  <td><strong><a data-field="airport-link" href="/ids/{{ row.icao }}">{{ row.icao }}</a></strong></td>
  <td>
    <span data-field="dep_rwys"{% if not row.dep_rwys %} class="text-muted"{% endif %}>{{ row.dep_rwys or "—" }}</span>
    {{- ids.source_badge(row.dep_source, row.match_icao, field="dep_source") }}
  </td>
  <td>
    <span data-field="arr_rwys"{% if not row.arr_rwys %} class="text-muted"{% endif %}>{{ row.arr_rwys or "—" }}</span>
    {{- ids.source_badge(row.arr_source, row.match_icao, field="arr_source") }}
  </td>
  <td>
    <span data-field="split"{% if not row.is_split %} hidden{% endif %}>
      <span data-field="dep_name" class="text-muted">{% if row.is_split %}DEP: {{ row.dep_name or "—" }}{% endif %}</span>
      <br>
      <span data-field="arr_name" class="text-muted">{% if row.is_split %}ARR: {{ row.arr_name or "—" }}{% endif %}</span>
    </span>
    <span data-field="flow_name"{% if row.is_split %} hidden{% endif %}>{% if not row.is_split %}{{ row.dep_name or "—" }}{% endif %}</span>
    <div data-field="suggestion" class="small fst-italic text-muted"{% if not row.suggestion %} hidden{% endif %}>{% if row.suggestion %}Suggested: {{ row.suggestion }}{% endif %}</div>
    <div data-field="issue" class="small text-warning"{% if not row.issue %} hidden{% endif %}>{{ row.issue or '' }}</div>
  </td>
  <td><span data-field="atis_info">{{ row.atis_info or '' }}</span></td>
  <td>{{ ids.conditions_badge(row.conditions, field="conditions") }}</td>
  <td><span data-field="wind"{% if not row.wind %} class="text-muted"{% endif %}>{{ row.wind or "—" }}</span></td>
  <td><span data-field="altimeter"{% if not row.altimeter %} class="text-muted"{% endif %}>{{ row.altimeter or "—" }}</span></td>
  <td><span data-field="raw_metar" class="{% if row.raw_metar %}font-monospace small{% else %}text-muted{% endif %}">{{ row.raw_metar or "—" }}</span></td>
</tr>
{% endmacro %}

{% block body %}

<h2>vZDV IDS</h2>

<div id="ids-page" data-mode="overview" data-url="/ids/data" data-warning="{{ warning or '' }}">
  {{ ids.status(updated_at, updated_z, warning) }}
  <p class="small text-muted">
    Runway sources: {{ ids.source_badge("atis", none) }} online ATIS,
    {{ ids.source_badge("matched", "KDEN") }} matched to another airport's flow,
    {{ ids.source_badge("weather", none) }} estimated from the wind.
  </p>
  <table id="ids-airports-table" class="table table-striped table-hover sortable"{% if not rows %} hidden{% endif %}>
    <thead>
      <tr>
        <th>Airport</th>
        <th>Departure Runways</th>
        <th>Arrival Runways</th>
        <th>Flow</th>
        <th>ATIS</th>
        <th>Conditions</th>
        <th>Wind</th>
        <th>Altimeter</th>
        <th>METAR</th>
      </tr>
    </thead>
    <tbody id="ids-airports-rows">
      {% for row in rows %}
        {{ airport_row(row) }}
      {% endfor %}
    </tbody>
  </table>
  <h4 id="ids-airports-empty"{% if rows %} hidden{% endif %}>No IDS airport data configured</h4>
  <template id="ids-airports-template">{{ airport_row({}) }}</template>
</div>

<script src="/static/sorttable.js"></script>
<script src="/static/ids_page.js" defer></script>

{% endblock %}
