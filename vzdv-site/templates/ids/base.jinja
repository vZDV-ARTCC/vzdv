{% extends "_layout.jinja" %}

{% block title %}IDS | {{ super() }}{% endblock %}

{% block extra_head %}
<style>#ids-page [hidden] { display: none !important; }</style>
{% endblock %}

{% macro airport_row(row) %}
<tr data-key="{{ row.icao or '' }}">
  <td>
    <strong>
      <a data-field="airport-link" href="/ids/{{ row.icao }}"{% if not row.is_split %} hidden{% endif %}>{% if row.is_split %}{{ row.icao }}{% endif %}</a>
      <span data-field="airport-name"{% if row.is_split %} hidden{% endif %}>{% if not row.is_split %}{{ row.icao }}{% endif %}</span>
    </strong>
  </td>
  <td><span data-field="dep_rwys"{% if not row.dep_rwys %} class="text-muted"{% endif %}>{{ row.dep_rwys or "—" }}</span></td>
  <td><span data-field="arr_rwys"{% if not row.arr_rwys %} class="text-muted"{% endif %}>{{ row.arr_rwys or "—" }}</span></td>
  <td>
    <span data-field="error" class="badge text-bg-warning"{% if not row.error %} hidden{% endif %}>{{ row.error or '' }}</span>
    <span data-field="split"{% if row.error or not row.is_split %} hidden{% endif %}>
      <span data-field="dep_name" class="text-muted">{% if not row.error and row.is_split %}D-ATIS: {{ row.dep_name or "—" }}{% endif %}</span>
      <br>
      <span data-field="arr_name" class="text-muted">{% if not row.error and row.is_split %}A-ATIS: {{ row.arr_name or "—" }}{% endif %}</span>
    </span>
    <span data-field="flow_name"{% if row.error or row.is_split %} hidden{% endif %}>{% if not row.error and not row.is_split %}{{ row.flow_name or "—" }}{% endif %}</span>
  </td>
  <td><span data-field="atis_info">{{ row.atis_info or '' }}</span></td>
  <td>
    <span data-field="conditions" class="{% if row.conditions == 'VFR' %}badge rounded-pill text-bg-success{% elif row.conditions == 'MVFR' %}badge rounded-pill text-bg-info{% elif row.conditions == 'IFR' %}badge rounded-pill text-bg-danger{% elif row.conditions == 'LIFR' %}badge rounded-pill{% else %}text-muted{% endif %}"{% if row.conditions == 'LIFR' %} style="background-color: purple;"{% endif %}>{{ row.conditions if row.conditions in ['VFR', 'MVFR', 'IFR', 'LIFR'] else '—' }}</span>
  </td>
  <td><span data-field="wind"{% if not row.wind %} class="text-muted"{% endif %}>{{ row.wind or "—" }}</span></td>
  <td><span data-field="altimeter"{% if not row.altimeter %} class="text-muted"{% endif %}>{{ row.altimeter or "—" }}</span></td>
  <td><span data-field="raw_metar" class="{% if row.raw_metar %}font-monospace small{% else %}text-muted{% endif %}">{{ row.raw_metar or "—" }}</span></td>
</tr>
{% endmacro %}

{% block body %}

<h2>vZDV IDS</h2>

<div id="ids-page" data-mode="overview" data-url="/ids/data" data-warning="{{ warning or '' }}">
  <p id="ids-status" class="{% if warning %}text-warning{% else %}text-muted{% endif %}">Snapshot updated: <time id="ids-updated" datetime="{{ updated_at }}">{{ updated_at }}</time></p>
  <p id="ids-warning" class="alert alert-warning" role="status"{% if not warning %} hidden{% endif %}>{% if warning %}{{ warning }} Displaying last available data; it may be stale.{% endif %}</p>
  <table id="ids-table" class="table table-striped table-hover sortable"{% if not rows %} hidden{% endif %}>
    <thead>
      <tr>
        <th>Airport</th>
        <th>Departure Runways</th>
        <th>Arrival Runways</th>
        <th>Flow</th>
        <th>ATIS</th>
        <th>Conditions</th>
        <th>Wind</th>
        <th>Altimeter</th>
        <th>METAR</th>
      </tr>
    </thead>
    <tbody id="ids-rows">
      {% for row in rows %}
        {{ airport_row(row) }}
      {% endfor %}
    </tbody>
  </table>
  <h4 id="ids-empty"{% if rows %} hidden{% endif %}>No IDS airport data configured</h4>
  <template id="ids-row-template">{{ airport_row({}) }}</template>
</div>

<script src="/static/sorttable.js"></script>
<script src="/static/ids_page.js" defer></script>

{% endblock %}
