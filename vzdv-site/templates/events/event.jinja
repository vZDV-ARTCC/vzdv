{% extends "_layout.jinja" %}

{% block title %}{{ event.name }} | {{ super() }}{% endblock %}

{% block body %}

<script defer src="/static/event_times.js"></script>
<script defer src="/static/event_page.js"></script>
<script defer src="/static/sorttable.js"></script>

<div class="row">
  <div class="col">
    <h2>
      {{ event.name }}
      {% if event.published %}{% else %}(unpublished){% endif %}
    </h2>
  </div>
</div>

<div class="row">
  <div class="col-12 col-lg-6">
    <h5 class="pt-3"><strong>Start:</strong> <span class="d-none event-time" updateTarget="editFormStart">{{ event.start }}</span></h5>
    <h5><strong>End:</strong> <span class="d-none event-time" updateTarget="editFormEnd">{{ event.end }}</span></h5>
    <p class="pt-3">{{ event.description }}</p>
    {% if is_event_staff %}
      <p class="text-muted">
        <i class="bi bi-map"></i>
        Assigned Enroute Split: <strong>{{ 'No split assigned' if not assigned_split else assigned_split.name }}</strong>
      </p>
    {% endif %}
    {% if event_not_over %}
      <div class="d-flex flex-wrap gap-2 pb-3">
        {% if user_info and user_info.is_some_staff or is_on_roster %}
          <button role="button" class="btn btn-primary" onclick="modalRegisterForm.showModal()">
            {% if self_register %}
              <i class="bi bi-pencil"></i> Update registration
            {% else %}
              <i class="bi bi-plus-circle"></i> Register
            {% endif %}
          </button>
        {% endif %}
        {% if is_event_staff %}
          <button role="button" class="btn btn-warning" onclick="modalEditForm.showModal()">
            <i class="bi bi-pencil"></i>
            Edit event
          </button>
          <button role="button" class="btn btn-warning" onclick="modalNoShow.showModal()">
            <i class="bi bi-alarm"></i>
            No shows
          </button>
          <button role="button" class="btn btn-warning" onclick="modalAssignSplit.showModal()">
            <i class="bi bi-map"></i>
            Assign Enroute Split
          </button>
          <button role="button" class="btn btn-danger" id="button-delete" event-id="{{ event.id }}">
            <i class="bi bi-trash"></i>
            Delete
          </button>
        {% endif %}
      </div>
    {% endif %}
  </div>
  <div class="col-12 col-lg-6">
    <img src="{{ event.image_url }}" alt="Event banner" class="img-fluid" />
  </div>
</div>

{% if cic_positions or (is_event_staff and event_not_over) %}
  <div class="d-flex align-items-center gap-3 pt-4 pb-2">
    <h4 class="mb-0">CIC Positions</h4>
    {% if is_event_staff and event_not_over %}
      <button class="btn btn-outline-warning btn-sm" id="btn-cic-position-add" type="button">+ Add</button>
    {% endif %}
  </div>
  <div class="row row-cols-1 row-cols-lg-3 gy-3">
    {% for position in cic_positions %}
      <div class="col">
        <div class="border rounded px-3 py-2 h-100 d-flex justify-content-between align-items-center gap-2">
          <div class="text-truncate">
            <div class="small text-body-secondary text-truncate">{{ position.category }}</div>
            <div class="text-truncate {% if not position.cid %}text-body-secondary{% endif %}">{{ position.controller }}</div>
          </div>
          {% if is_event_staff and event_not_over %}
            <div class="d-flex gap-2 flex-shrink-0">
              <button class="btn btn-outline-warning btn-sm btn-cic-position-set" position_id="{{ position.id }}" controller_id="{{ position.cid or 0 }}" type="button" title="Set controller"><i class="bi bi-person"></i></button>
              <form action="/events/{{ event.id }}/delete_cic_position/{{ position.id }}" method="POST">
                <button class="btn btn-outline-danger btn-sm" type="submit" title="Delete"><i class="bi bi-trash"></i></button>
              </form>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}

<div class="row gy-4 pt-4">
  {% for category in position_categories %}
    <div class="col-12 col-lg-4">
      <h4>{{ category }} Positions</h4>
      <ul class="list-group">
        {% for position in positions if position.category == category %}
          <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
            <span>
              {{ position.name }} -
              {% if position.cid %}{{ position.controller }}{% else %}<span class="text-body-secondary">{{ position.controller }}</span>{% endif %}
            </span>
            {% if is_event_staff and event_not_over %}
              <div class="d-flex gap-2 flex-shrink-0">
                <button class="btn btn-outline-warning btn-sm btn-position-set" position_id="{{ position.id }}" type="button" title="Set controller"><i class="bi bi-person"></i></button>
                <form action="/events/{{ event.id }}/delete_position/{{ position.id }}" method="POST">
                  <button class="btn btn-outline-danger btn-sm" type="submit" title="Delete"><i class="bi bi-trash"></i></button>
                </form>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      {% if event_not_over and is_event_staff %}
        <button class="btn btn-outline-warning btn-sm w-100 mt-2 btn-position-add" category="{{ category }}" type="button">+ Add</button>
      {% endif %}
      {% if is_event_staff %}
        <h6 class="pt-3">Any {{ category }}</h6>
        <ul class="list-group">
          {% for entry in any_pools[category] %}
            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
              {% if entry.is_assigned %}
                <span class="text-info"><i class="bi bi-check" title="Assigned to a position"></i> {{ entry.controller }}</span>
              {% else %}
                <span>{{ entry.controller }}</span>
              {% endif %}
              <span class="small text-body-secondary flex-shrink-0">Choice {{ entry.rank }}</span>
            </li>
          {% else %}
            <li class="list-group-item text-body-secondary">No sign-ups</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  {% endfor %}
</div>

{% if is_event_staff %}
  <div class="pt-3"></div>
  <hr />
  <h2>
    Sign-ups
    <span class="badge rounded-pill text-bg-light fs-6">{{ registrations|length }}</span>
  </h2>
  <table class="table table-striped table-hover sortable" style="table-layout: fixed">
    <thead>
      <tr>
        <th>Controller</th>
        <th>Choice 1</th>
        <th>Choice 2</th>
        <th>Choice 3</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      {% for registration in registrations %}
        <tr>
          {% if registration.is_assigned %}
            <td class="text-info">
              <i class="bi bi-check" title="Assigned to a position"></i>
              {{ registration.controller }}
              <a href="/controller/{{ registration.cid }}" class="icon-link icon-link-hover text-decoration-none">
                <i class="bi bi-arrow-right-short"></i>
              </a>
            </td>
          {% else %}
            <td>
              {{ registration.controller }}
              <a href="/controller/{{ registration.cid }}" class="icon-link icon-link-hover text-decoration-none">
                <i class="bi bi-arrow-right-short"></i>
              </a>
            </td>
          {% endif %}
          <td class="{% if registration.is_assigned %}text-info{% endif %}">{{ registration.choice_1 }}</td>
          <td class="{% if registration.is_assigned %}text-info{% endif %}">{{ registration.choice_2 }}</td>
          <td class="{% if registration.is_assigned %}text-info{% endif %}">{{ registration.choice_3 }}</td>
          <td class="{% if registration.is_assigned %}text-info{% endif %}">{{ registration.notes }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}

<dialog id="modalEditForm">
  <h2 class="pb-3">Edit event</h2>
  <form action="/events/{{ event.id }}" method="POST" enctype="multipart/form-data">
    <div class="row">
      <div class="col">
        <div class="mb-3">
          <label for="name" class="form-label">Event name</label>
          <input type="text" class="form-control" name="name" value="{{ event.name }}" required>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea class="form-control" name="description">{{ event.description }}</textarea>
        </div>
        <div class="row mb-3">
          <p class="mb-2" style="font-size: 80%">This is the banner that'll be shown for the event. Either use a URL for the image, or upload the image file here. Don't do both.</p>
          <div class="col">
            <label for="banner" class="form-label">Banner URL (image already hosted somewhere)</label>
            <input type="text" class="form-control" name="banner" value="{{ event.image_url }}">
          </div>
          <div class="col">
            <label for="banner_file" class="form-label">Banner Image Upload (host the image on our site)</label>
            <input type="file" class="form-control" name="banner_file">
          </div>
        </div>
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" value="" id="published" name="published" {% if event.published %}checked{% endif %}>
          <label class="form-check-label" for="published">
            Published
          </label>
        </div>
        <div class="row mb-3">
          <div class="col">
            <label for="start" class="form-label">Start (Zulu)</label>
            <input type="datetime-local" name="start" id="editFormStart" class="form-control" data-zulu-input required>
          </div>
          <div class="col">
            <label for="end" class="form-label">End (Zulu)</label>
            <input type="datetime-local" name="end" id="editFormEnd" class="form-control" data-zulu-input required>
          </div>
        </div>
        <div class="d-flex justify-content-between">
          <button class="btn btn-warning" role="button" id="btn-modal-edit-close">Close</button>
          <button class="btn btn-success" role="button" type="submit">Save</button>
        </div>
      </div>
    </div>
  </form>
</dialog>

<dialog id="modalRegisterForm">
  <h2 class="pb-3">Register</h2>
  <form action="/events/{{ event.id }}/register" method="POST">
    <div class="row">
      <div class="col">
        {% for n in [1, 2, 3] %}
          {% set selected_position = self_register['choice_' ~ n] if self_register else none %}
          {% set selected_any = self_register['choice_' ~ n ~ '_any'] if self_register else none %}
          <div class="mb-3">
            <select class="form-select" name="choice_{{ n }}">
              <option value="0">~ Empty</option>
              {% for category in position_categories %}
                <optgroup label="{{ category }}">
                  <option value="any:{{ category }}" {% if selected_any == category %}selected="selected"{% endif %}>Any {{ category }}</option>
                  {% for position in positions_raw if position.category == category %}
                    <option value="{{ position.id }}" {% if selected_position == position.id %}selected="selected"{% endif %}>{{ position.name }}</option>
                  {% endfor %}
                </optgroup>
              {% endfor %}
            </select>
          </div>
        {% endfor %}
        <div class="mb-3">
          <label for="notes" class="form-label">Notes</label>
          <textarea name="notes" class="form-control" maxlength="500">{{ self_register.notes }}</textarea>
        </div>
        <div class="d-flex justify-content-between">
          <button class="btn btn-warning" role="button" id="btn-modal-register-close">Close</button>
          <div class="">
            {% if self_register %}
              <button class="btn btn-danger" role="button" id="btn-modal-register-unregister" event-id="{{ event.id }}">Unregister</button>
            {% endif %}
            <button class="btn btn-success" role="button" type="submit">Save</button>
          </div>
        </div>
      </div>
    </div>
  </form>
</dialog>

<dialog id="modalAddPosition">
  <h2 class="pb-3">Add position</h2>
  <form action="/events/{{ event.id }}/add_position" method="POST">
    <div class="row">
      <div class="col">
        <input type="hidden" name="category" id="new-position-category">
        <div class="mb-3">
          <label for="name" class="form-label">Position</label>
          <input type="text" class="form-control" name="name" style="text-transform: uppercase">
        </div>
        <div class="d-flex justify-content-between">
          <button class="btn btn-warning" role="button" id="btn-modal-add-position-close">Close</button>
          <button class="btn btn-success" role="button" type="submit">Add</button>
        </div>
      </div>
    </div>
  </form>
</dialog>

<dialog id="modalSetPosition">
  <h2 class="pb-3">Set position</h2>
  <form action="/events/{{ event.id }}/set_position" method="POST">
    <div class="row">
      <div class="col">
        <input type="hidden" name="position_id" id="set-position-id">
        <p>Either select a controller from the dropdown, or enter a controller's CID into the second field.</p>
        <div class="mb-3">
          <label for="controller" class="form-label">On-roster</label>
          <select class="form-select" name="controller">
            <option value="0">Empty</option>
            {% for (cid, name) in all_controllers %}
              <option value="{{ cid }}">{{ name }}</option>
            {% endfor %}
          </select>
          <hr>
          <label for="controller_cid" class="form-label">CID entry</label>
          <input type="number" min="0" id="controller_cid" name="controller_cid" class="form-control">
        </div>
        <div class="d-flex justify-content-between">
          <button class="btn btn-warning" role="button" id="btn-modal-set-position-close">Close</button>
          <button class="btn btn-success" role="button" type="submit">Save</button>
        </div>
      </div>
    </div>
  </form>
</dialog>

{% if is_event_staff %}
  <dialog id="modalAddCicPosition">
    <h2 class="pb-3">Add CIC position</h2>
    <form action="/events/{{ event.id }}/add_cic_position" method="POST">
      <div class="row">
        <div class="col">
          <div class="mb-3">
            <label for="cic-category" class="form-label">Category</label>
            <input type="text" class="form-control" id="cic-category" name="category" maxlength="{{ cic_category_max_length }}" placeholder="e.g. DEN, D01, Enroute, Event" required>
          </div>
          <div class="d-flex justify-content-between">
            <button class="btn btn-warning" type="button" id="btn-modal-add-cic-position-close">Close</button>
            <button class="btn btn-success" type="submit">Add</button>
          </div>
        </div>
      </div>
    </form>
  </dialog>

  <dialog id="modalSetCicPosition">
    <h2 class="pb-3">Set CIC position</h2>
    <form action="/events/{{ event.id }}/set_cic_position" method="POST">
      <div class="row">
        <div class="col">
          <input type="hidden" name="position_id" id="set-cic-position-id">
          <div class="mb-3">
            <label for="cic-controller" class="form-label">Registered controller</label>
            <select class="form-select" name="controller" id="cic-controller">
              <option value="0">Unassigned</option>
              {% for (cid, name) in registered_controllers %}
                <option value="{{ cid }}">{{ name }}</option>
              {% endfor %}
            </select>
            <div class="form-text">Only controllers who have registered for this event can be assigned as CIC.</div>
          </div>
          <div class="d-flex justify-content-between">
            <button class="btn btn-warning" type="button" id="btn-modal-set-cic-position-close">Close</button>
            <button class="btn btn-success" type="submit">Save</button>
          </div>
        </div>
      </div>
    </form>
  </dialog>
{% endif %}

<dialog id="modalNoShow">
  <h2 class="pb-3">No shows</h2>
  <form action="/events/{{ event.id }}/no_show" method="POST">
    <div class="row">
      <div class="col">
        <div class="mb-3">
          <p>
            Use this form to add a record for a controller who did not show for the event or who was late.
            <br>
            To <i>remove</i> these records, see the <a href="/admin/no_show_list" class="text-decoration-none">corresponding admin page</a>.
          </p>
          <label for="form-select" name="cid">Controller</label>
          <select class="form-select" name="cid">
            {% for (cid, name) in all_controllers %}
              <option value="{{ cid }}">{{ name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="mb-3">
          <label for="notes" class="form-label">Notes</label>
          <textarea name="notes" class="form-control"></textarea>
        </div>
        <div class="d-flex justify-content-between">
          <button class="btn btn-warning" role="button" id="btn-modal-no-show-close">Close</button>
          <button class="btn btn-primary" role="button" type="submit">Submit</button>
        </div>
      </div>
    </div>
  </form>
</dialog>

<dialog id="modalAssignSplit">
  <h2 class="pb-3">Assign Enroute Split</h2>
  <form action="/events/{{ event.id }}/assign_enroute_sector_split" method="POST">
    <div class="row">
      <div class="col">
        <input type="hidden" name="split_name" id="assign-split-name">
        <div class="mb-3">
          <label for="assign-split-id" class="form-label">Split</label>
          <select class="form-select" name="split_id" id="assign-split-id" required>
            <option value="">-- Select split --</option>
            {% for split in enroute_splits %}
              <option value="{{ split.id }}" data-name="{{ split.name }}" {% if assigned_split and assigned_split.id == split.id %}selected{% endif %}>{{ split.name }}</option>
            {% endfor %}
          </select>
          <div class="form-text">
            Need to make a custom split map? <a href="/airspace/splits" target="_blank">Click here to create one</a>.
          </div>
        </div>
        <div class="d-flex justify-content-between">
          <button class="btn btn-warning" type="button" onclick="modalAssignSplit.close()">Close</button>
          <button class="btn btn-success" role="button" type="submit">Save</button>
        </div>
      </div>
    </div>
  </form>

  <form action="/events/{{ event.id }}/remove_enroute_sector_split" method="POST" class="mt-2">
    <button type="submit" class="btn btn-outline-danger" {% if not assigned_split %}disabled{% endif %}>
      <i class="bi bi-x-circle"></i> Remove assignment
    </button>
  </form>
</dialog>

<script>
  (function () {
    const select = document.getElementById('assign-split-id');
    const nameInput = document.getElementById('assign-split-name');
    if (select && nameInput) {
      function updateName() {
        const opt = select.options[select.selectedIndex];
        nameInput.value = opt ? opt.dataset.name : '';
      }
      select.addEventListener('change', updateName);
      updateName();
    }
  })();
</script>

{% endblock %}
